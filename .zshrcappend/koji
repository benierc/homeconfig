function look_pkg_in_distro {
	local redpeskver=$1
	local pkg=$2
	local repokojidistro="http://distro-app-next.lorient.iot/kojifiles/repos/import-redpesk-lts-${redpeskver}-update-build/latest/x86_64"
	find=$(dnf -q --installroot /tmp/dnftmp$redpeskver --repofrompath r,$repokojidistro --repo r repoquery --whatprovides $pkg)
	[ -z "$find" ] && return 1
	return 0
}

function download_pkg {
	local rhelver=$1
	local redpeskver=$2
	local pkg=$3
	echo
	echo "pkg=$pkg ..."

	local koji_rocky_tag=import-$redpeskver-rocky-update-release
	local koji_epel_tag=import-$redpeskver-epel-update-release

	local epel=0
	local srpm=$(dnfsilo $rhelver -q repoquery --whatprovides $pkg --qf '%{sourcerpm}')
	[ -z "$srpm" ] && srpm=$(dnfepel $rhelver -q repoquery --whatprovides $pkg --qf '%{sourcerpm}') && epel=1

	[ -z "$srpm" ] && echo "srpm for $rhelver $pkg" && continue

	local koji=
	local kojitag=
	if [ $epel -eq 0 ]; then
		koji="https://koji.rockylinux.org/koji/search?match=glob&type=build&terms="
		kojitag=$koji_rocky_tag
	else
		koji="https://koji.fedoraproject.org/koji/search?match=glob&type=build&terms="
		kojitag=$koji_epel_tag
	fi

	local buildid=${srpm::-8}
	local kojibuild="${koji}$(echo ${buildid} | jq -sRr @uri)"
	local srpmurl=$(wget -q -O - $kojibuild | grep -o "href=\"http.*.src.rpm" | sed -r "s#.*(https://.*.src.rpm).*#\1#")

	local downloadurl=$(dirname $(dirname $srpmurl))
	echo "$downloadurl"

	(
		mkdir -p tmp/rpms-$buildid
		cd tmp/rpms-$buildid
		downloadrpmfromexternalkoji "$downloadurl" noarch x86_64 aarch64
		kojidn_importrpmstag $kojitag

		# check require exist in koji
		echo "looking for missing requires for $buildid"
		local rpmslist=$(ls *.rpm | grep -E "noarch|x86_64")
		local provides=$(rpm -qp --provides $(echo $rpmslist))

		IFS=$'\n'; for require in $(rpm -qp --requires $(echo $rpmslist) | sort | uniq | grep -v rpmlib\(); do
			look_pkg_in_distro $redpeskver $require && continue

			# check if require is in provides
			echo $require | grep -q $provides && continue
			echo "missing require=$require"
			download_pkg $rhelver $redpeskver "$require"
		done

	)
}

function import_from_nothing_provides {
	local rhelver=$1
	local redpeskver=$2

	for pkg in $(cat $file | grep "nothing provides" | awk '{print $4}'); do
		download_pkg $rhelver $redpeskver $pkg
	done
}
